<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
    <id>com.specificlanguages.mops.daemon.plugin</id>
    <name>mops daemon plugin bridge</name>
    <depends>com.intellij.modules.mps</depends>
    <depends>jetbrains.mps.core</depends>
    <depends>jetbrains.mps.ide.java</depends>
    <dependencies>
        <plugin id="jetbrains.mps.core" />
        <plugin id="jetbrains.mps.ide.java" />
    </dependencies>
    <extensions defaultExtensionNs="com.intellij">
        <vfs.local.pluggableFileWatcher
            implementation="com.specificlanguages.mops.daemon.plugin.HeadlessNativeFileWatcher"/>
    </extensions>
</idea-plugin>
